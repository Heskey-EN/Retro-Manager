# Eco Futures Retrofit Suite — HUB Supabase connection.
# Copy this file to ".env" and fill in the HUB project's values (the same
# project the Retrofit Suite login on ecofutures.uk uses — see the EcoFutures
# repo, supabase/hub/README.md). This app has no Supabase project of its own.
#
# Until these are set, the app runs in LOCAL mode: jobs are stored in your
# browser and synced across tabs on the same machine (no multi-user sync).

VITE_HUB_SUPABASE_URL=
VITE_HUB_SUPABASE_ANON_KEY=

# Where "Sign in" links point. Leave unset in production (defaults to
# https://ecofutures.uk). For local dev, run the EcoFutures site locally and:
# VITE_SUITE_HUB_URL=http://localhost:5180
